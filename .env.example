# ---------------------------------------------------------------------------
# Agent Shaker — environment reference
#
# Copy to .env and adjust:  cp .env.example .env
# Compose reads .env automatically. Never commit the real .env (it is
# git-ignored).
# ---------------------------------------------------------------------------

# ---- Database (required) ---------------------------------------------------
# The compose topology puts Postgres on an internal bridge network, so
# sslmode=disable is correct there. Against a managed instance use
# sslmode=verify-full, or the server refuses to start in production.
DATABASE_URL=postgres://mcp:secret@localhost:5433/mcp_tracker?sslmode=disable

# Consumed by docker-compose.yml to build DATABASE_URL. Required for compose.
POSTGRES_DB=mcp_tracker
POSTGRES_USER=mcp
POSTGRES_PASSWORD=change-me

# ---- Server ----------------------------------------------------------------
PORT=8080

# development | production.
# In production the TLS guard rejects sslmode=disable against a public host.
ENV=development

# Applied at boot unless set to the literal string "false". Compose already runs
# migrations as a separate one-shot job, so compose sets this to false to avoid
# two processes migrating the same database concurrently.
RUN_MIGRATIONS_ON_START=true

# NOT required for the bundled TLS edge. HSTS is decided per request from the
# request itself (r.TLS, or X-Forwarded-Proto which Caddy sets), so enabling
# `tls` gives you HSTS with no extra configuration.
#
# Set this only when a fronting proxy does NOT set X-Forwarded-Proto — a raw
# TCP passthrough, or a hand-rolled one. It does not enable TLS; it only tells
# the API to assume the client-facing hop is encrypted.
#
# It used to be a mandatory pairing with the `tls` profile. Because compose
# cannot set an env var based on whether a profile is active, that made it a
# second flag to remember, and omitting it silently disabled HSTS: the service
# started healthy and simply never sent the header.
TLS_TERMINATED=false

# ---- TLS edge (optional) --------------------------------------------------
# The bundled Caddy service is opt-in so it does not fight an existing reverse
# proxy, load balancer, or a plain laptop run.
#
#   docker compose --profile tls up -d
#
# PUBLIC_HOST   the domain Caddy issues a certificate for.
# ACME_EMAIL    Let's Encrypt expiry notices.
#
# !! BOTH MUST BE SET TO SOMETHING REAL, OR YOU GET NO TLS AT ALL. !!
#
# Both compose and the Caddyfile fall back to `localhost`, and Caddy issues no
# certificate for `localhost` — it serves plain HTTP on :80 and says nothing.
# So the stack comes up, reports itself healthy, has basic auth in front of it,
# and is transmitting the UI password in cleartext over a connection that looks
# encrypted because the service is named `edge` and the profile is called `tls`.
# There is no error to notice and nothing in any log.
#
# Left empty is only correct for a local run:
#
#   PUBLIC_HOST=localhost   # plain HTTP, no certificate, local only
#
# For a real deployment set the actual FQDN, which must resolve publicly to this
# host's IP or the ACME challenge cannot complete. `scripts/deploy.sh` sets both
# for you and waits for the certificate before reporting success.
PUBLIC_HOST=
ACME_EMAIL=

# BASIC_AUTH_USER / BASIC_AUTH_HASH are required for the edge to BOOT — the API
# key is not a login, so the edge is the only access control in the topology.
# The `edge` service refuses to start without them and prints how to generate a
# hash. Generate one:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# !! DO NOT PUT THE HASH IN .env. !!
#
# Docker Compose interpolates `$VAR` inside env-file values, and a bcrypt hash
# is `$2a$14$<salt><digest>` — the `$<salt>` segment looks exactly like a
# variable reference and is silently replaced with an empty string. The edge
# then starts healthy and rejects every correct password: a lockout with no
# error anywhere. Doubling the `$` does NOT help; service-level `env_file` is
# mangled the same way.
#
# Export it from the shell instead, where nothing re-interprets the value:
#   export BASIC_AUTH_USER=admin
#   export BASIC_AUTH_HASH='$2a$14$...'      # single quotes, literally
#   docker compose --profile tls up -d
#
# A shell variable takes precedence over .env, so this works alongside a
# populated .env. The same trap does not apply to API_KEYS or
# POSTGRES_PASSWORD, which contain no `$`.
#
# Leaving these blank is fine for a plain `docker compose up -d`: these are only
# read by the opt-in `tls` profile, and compose will not demand them until the
# edge actually starts.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# ---- Local exposure -------------------------------------------------------
# The Nuxt service is bound to loopback by default. Set WEB_BIND=0.0.0.0 to
# reach it from another machine on the LAN — but only on a trusted network, and
# only if you are not running the TLS edge (which should be the sole entrypoint).
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ---- CORS / WebSocket origins ---------------------------------------------
# Comma-separated. In the single-origin compose topology the browser only ever
# calls the Nuxt origin, and the Nitro proxy is server-to-server, so this only
# needs the public UI origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origin allow-list for the WebSocket upgrade check. Must include the public
# origin that serves the UI, otherwise the browser handshake is rejected.
WS_ALLOWED_ORIGINS=http://localhost:3000

# Enables Access-Control-Allow-Credentials. Independent of authentication, and
# off by default: the single-origin topology does not need it, and turning it on
# forces every origin in the allow-list to be exact (no wildcards).
CORS_ALLOW_CREDENTIALS=false

# ---- API-key authentication ----------------------------------------------
# OFF by default for local development. Turn it ON for any deployment that is
# reachable from a network you do not control.
#
# When AUTH_ENABLED=true and API_KEYS is empty the server refuses to boot
# (exit 2) rather than serving unauthenticated. That is deliberate: a
# half-configured deployment should fail loudly at deploy time, not silently
# at 3am.
#
# Comma-separated. Several keys let you rotate one client at a time.
# Generate with:  openssl rand -hex 32
AUTH_ENABLED=false
API_KEYS=

# The Nuxt proxy injects this key when forwarding to the Go service on behalf
# of the browser. It is server-only runtimeConfig, so it is never included in
# the client bundle.
#
# DO NOT SET IT HERE. docker-compose.yml assigns
# `NUXT_API_KEY: ${API_KEYS:?...}`, so whatever you write on this line is
# discarded: .env supplies values for ${} substitution, it does not set
# container environment variables. API_KEYS above is the real knob, and the key
# injected is that value verbatim rather than something you match against it.
# This line only takes effect if you run the Nuxt service outside compose.
#
# Consequence worth understanding: anyone who can load the web UI can use the
# API through it. The key protects the Go service's own surface, not the app's
# user accounts. Put access control in front of the web service (VPN, basic
# auth in Caddy, an SSO proxy) if that is not enough.
NUXT_API_KEY=

# Origin allow-list for the /ws handshake, enforced in the Nitro proxy.
# Comma-separated; empty means same-origin only, which is correct when the UI
# and the proxy share an origin (the default topology).
#
# This exists because the proxy injects NUXT_API_KEY for every caller: the
# Go-side Origin check is bypassed for browser traffic, so without this the
# WebSocket endpoint would be open to cross-site hijacking.
NUXT_WS_ALLOWED_ORIGINS=

# ---- Task storage ----------------------------------------------------------
# memory = in-process, lost on restart. postgres = durable, survives restarts.
TASK_STORE=memory

# ---- Rate limiting ---------------------------------------------------------
# Token bucket, per client IP. Excluded paths: /ws /healthz /readyz /metrics.
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Read the client address from X-Forwarded-For. Compose already sets this to
# true for the mcp-server service, which is correct there specifically because
# that service publishes no host port — every request arrives over the internal
# network from the edge, never from a client directly.
#
# Leave it unset for a bare binary. If the service is reachable other than
# through a proxy you control, a caller can forge this header; the limiter reads
# the RIGHTMOST entry, which a real proxy appends, so forging only produces
# entries that are ignored — but running without any proxy at all means there is
# no real client address to read and the per-IP buckets would key on whatever
# address the socket reports.
TRUSTED_PROXY=false

# ---- Request limits --------------------------------------------------------
# Maximum accepted request body, in bytes (10 MiB).
MAX_BODY_BYTES=10485760

# ---- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# ---- OpenTelemetry ---------------------------------------------------------
# Leave empty to disable tracing entirely (the default: no-op exporter, zero
# overhead). Set to an OTLP/HTTP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fraction of traces sampled. 0.05 = 5%.
OTEL_TRACES_SAMPLER_ARG=0.05

# ---- Web (Nuxt SSR) --------------------------------------------------------
# WEB_BIND and WEB_PORT are declared in the TLS edge section above; they
# control how the Nuxt service is published on the host.
#
# Server-only upstream used by server/routes/api/[...path].ts. In compose this
# is the internal service hostname and is deliberately not NUXT_PUBLIC_*.
#
# All three below are assigned by docker-compose.yml, so setting them here does
# nothing: the upstream is the internal service address, and the two PUBLIC
# bases are forced empty so the SPA resolves same-origin /api and /ws. They are
# listed because they DO apply when the Nuxt service runs outside compose —
# where you would set the public bases only if the SPA and the Go API are
# served from different origins. Under compose, change docker-compose.yml.
NUXT_API_UPSTREAM=http://mcp-server:8080
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_WS_BASE=
