{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MINIMAX_HOOKS_DIR}/agent-shaker-hook.mjs\"",
            "commandWindows": "node \"${MINIMAX_HOOKS_DIR}\\agent-shaker-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MINIMAX_HOOKS_DIR}/agent-shaker-hook.mjs\"",
            "commandWindows": "node \"${MINIMAX_HOOKS_DIR}\\agent-shaker-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MINIMAX_HOOKS_DIR}/agent-shaker-hook.mjs\"",
            "commandWindows": "node \"${MINIMAX_HOOKS_DIR}\\agent-shaker-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
