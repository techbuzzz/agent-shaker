# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#

# ---- Build artifacts ----
# NOTE: these patterns must be anchored with a leading slash. A bare `server`
# matches at *any* depth, which silently swallowed cmd/server/ and web/server/
# (the latter holds the Nitro proxy routes the production topology depends on).
/mcp-server
/server
/bin/
/web/dist/
/web/.output/
/web/.nuxt/
/web/node_modules/
/web/_out_old/
/cover.out
/cover.html

# Coverage + test output
*.out
coverage.*
*.coverprofile
profile.cov
*.test

# Compiled objects
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
*.a

# Go workspace
go.work
go.work.sum

# ---- Secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Database ----
postgres_data/
*.sqlite
*.sqlite3
*.db

# ---- Logs ----
*.log
/logs/

# ---- Editor / IDE ----
.idea/
.vscode/
*.swp
*.swo
*~
/.vs
/.history

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Local helper scripts ----
# Machine-local build/verify helpers. Kept out of the repo deliberately: they
# encode one developer's shell, not a project-wide contract. `make` and CI are
# the supported entry points.
/.*.ps1
/.verify-*.mjs

# Scratch files (commit messages, ad-hoc probes)
/.commit-msg.tmp

# Scratch env files. These get written when testing a compose profile by hand and
# routinely contain real material — a bcrypt hash, an API key. Never commit one
# by accident; `git add -A` should not be able to pick them up.
/.*.env.tmp
/*.env.tmp
/*.tmp
