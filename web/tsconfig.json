{
  // Nuxt-generated base config. Regenerated by `nuxt prepare` on every
  // install/build, so project-level settings belong here, not in .nuxt/.
  "extends": "./.nuxt/tsconfig.json",

  "vueCompilerOptions": {
    // The generated config registers `vue-router/volar/sfc-route-blocks`,
    // but vue-router 4.6 removed the `volar/` directory entirely. Volar then
    // throws "plugin is not a function" while building the language plugin
    // set, which silently degrades .vue type inference and makes the
    // typecheck gate report nonsense.
    //
    // That plugin only provided <route>-block awareness inside Vue Router
    // SFCs. Nuxt 4 uses file-based routing, so nothing in this app uses those
    // blocks — clearing the list costs us nothing and restores a working
    // typechecker. Re-check this after a major vue-router bump.
    "plugins": []
  }
}
